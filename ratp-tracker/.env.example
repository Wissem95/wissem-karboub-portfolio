# --- Source officielle : API Ile-de-France Mobilites (plateforme PRIM) ---
# Cree un compte gratuit sur https://prim.iledefrance-mobilites.fr/
# puis genere une cle dans "Mes jetons d'authentification".
# Sans cle, le site fonctionne quand meme via le scraping + des donnees de demo.
IDFM_API_KEY=

# Optionnel : URL de l'endpoint "disruptions" (Navitia) exposé par PRIM.
# Laisser vide pour utiliser la valeur par defaut.
IDFM_DISRUPTIONS_URL=

# Optionnel : page d'info-trafic publique scrappee par le bot (sans cle).
RATP_TRAFFIC_URL=
